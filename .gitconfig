[core]
  excludesfile = ~/.gitignore_global
[alias]
  s = status
  st = status
  b = branch
  d = diff
  dd = diff -r HEAD^
  dc = diff --cached
  co = checkout
  amend = commit --amend --no-edit
  sl = log --graph --pretty='%C(yellow)%h %C(green)%cn %C(blue)%ad %C(red)%s ' --date=human --oneline --branches --not origin/main
# separate file for username / auth
[include]
  path = ~/.gitconfig.local
